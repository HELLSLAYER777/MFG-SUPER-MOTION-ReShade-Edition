<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<!-- "Publish" in Visual Studio (or: dotnet publish ARMO\ARMO.fsproj -p:PublishProfile=FolderProfile):
     the app, whole, into PublishDir - Windows x64, with .NET inside it (nothing to install first), the engine in
     its Engine folder - and then the installer made of that folder (Installer\MfgSuperMotion.iss, Inno Setup)
     into SetupDir. ARMO.fsproj has the step that runs Inno Setup. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>C:\dev\mfg super motion pub\</PublishDir>
    <SetupDir>C:\dev\mfg super motion pub set up\</SetupDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- The app is published without the engine: it downloads it when first opened (Infrastructure\Updates.fs).
         The engine goes out as a zip of its own, made beside the installer. -->
    <WithoutEngine>true</WithoutEngine>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Nothing left over from the publish before; no debug files; only the languages the app's own texts are in
         (its translations are inside the program, not in these folders). -->
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
